
{
  "manifest_version": 3,
  "name": "Bezkriedy slovicka autosolver",
  "version": "0.1",

  "description": "Automaticky vyrieši slovíčkového papagája",

  "browser_specific_settings": {
    "gecko": {
      "id": "bezkauto@eeper242.org",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "permissions": [
    "storage"
  ],

  "content_scripts": [
    {
      "matches": ["*://*.bezkriedy.sk/papagaj.php*"],
      "js": ["bezk.js"],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["settings.json"],
      "matches": ["https://www.bezkriedy.sk/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Otvoriť nastavenia"
  }
}